<odoo>

    <record id="res_partner_view_form_mailing" model="ir.ui.view">
        <field name="name">res.partner.view.form.mailing</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_mailing_traces"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-envelope"
                >
                    <field
                        name="mailing_trace_count"
                        widget="statinfo"
                        string="Mailings"
                    />
                </button>
            </div>
        </field>
    </record>

</odoo>
