<odoo>

    <record id="mailing_trace_partner_tree_view" model="ir.ui.view">
        <field name="name">mailing.trace.partner.tree</field>
        <field name="model">mailing.trace</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sent" />
                <field name="mass_mailing_id" />
                <field name="is_received" />
                <field name="is_opened" />
                <field name="is_clicked" />
            </tree>
        </field>
    </record>

</odoo>
