<odoo>

    <record model="ir.ui.view" id="membership_request_origin_form_view">
        <field name="model">membership.request.origin</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record model="ir.ui.view" id="membership_request_origin_tree_view">
        <field name="model">membership.request.origin</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name" />
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="membership_request_origin_act_window">
        <field name="name">Membership Request Origins</field>
        <field name="res_model">membership.request.origin</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.ui.menu" id="membership_request_origin_menu">
        <field name="name">Membership Request Origins</field>
        <field name="parent_id" ref="mozaik_membership.membership_submenu" />
        <field name="action" ref="membership_request_origin_act_window" />
        <field name="sequence" eval="20" />
    </record>

</odoo>
