<odoo>

    <record id="virtual_partner_employee_tree_view" model="ir.ui.view">
        <field name="name">virtual.partner.employee.tree</field>
        <field name="model">virtual.partner.employee</field>
        <field
            name="inherit_id"
            ref="mozaik_communication.abstract_virtual_model_tree_view"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="employee_id" />
                <field name="department_id" />
                <field name="parent_id" />
                <field name="coach_id" />
                <field name="job_id" optional="hide" />
                <field name="work_email" optional="hide" />
                <field name="work_phone" optional="hide" />
            </field>
        </field>
    </record>

    <record id="virtual_partner_employee_search_view" model="ir.ui.view">
        <field name="name">virtual.partner.employee.search</field>
        <field name="model">virtual.partner.employee</field>
        <field name="mode">primary</field>
        <field
            name="inherit_id"
            ref="mozaik_communication.abstract_virtual_model_search_view"
        />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="employee_id" />
                <field name="department_id" />
                <field name="parent_id" />
                <field name="coach_id" />
                <field name="job_id" />
            </field>
            <filter name="partner" position="after">
                <filter
                    name="department"
                    string="Department"
                    context="{'group_by':'department_id'}"
                />
                <filter
                    name="manager"
                    string="Manager"
                    context="{'group_by':'parent_id'}"
                />
                <filter name="coach" string="Coach" context="{'group_by':'coach_id'}" />
                <filter
                    name="job"
                    string="Job Position"
                    context="{'group_by':'job_id'}"
                />
            </filter>
        </field>
    </record>

    <record id="virtual_partner_employee_action" model="ir.actions.act_window">
        <field name="name">Partners/Employees</field>
        <field name="res_model">virtual.partner.employee</field>
        <field name="view_mode">tree</field>
        <field name="search_view_id" ref="virtual_partner_employee_search_view" />
        <field name="view_id" ref="virtual_partner_employee_tree_view" />
    </record>

    <record model="ir.ui.menu" id="virtual_partner_employee_menu">
        <field name="name">Partners/Employees</field>
        <field name="sequence" eval="50" />
        <field name="parent_id" ref="mozaik_communication.virtual_model_menu" />
        <field name="action" ref="virtual_partner_employee_action" />
    </record>

</odoo>
