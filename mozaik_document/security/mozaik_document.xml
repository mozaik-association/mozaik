<odoo>
    <record model="ir.model.access" id="mozaik_document_reader">
        <field name="name">mozaik.document reader</field>
        <field name="model_id" ref="model_mozaik_document" />
        <field name="group_id" ref="mozaik_document.group_document_reader" />
        <field name="perm_read" eval="1" />
        <field name="perm_create" eval="0" />
        <field name="perm_write" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

    <record model="ir.model.access" id="mozaik_document_user">
        <field name="name">mozaik.document user</field>
        <field name="model_id" ref="model_mozaik_document" />
        <field name="group_id" ref="mozaik_document.group_document_user" />
        <field name="perm_read" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

</odoo>
