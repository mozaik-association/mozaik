<odoo>

    <record model="ir.module.category" id="module_category_document">
        <field name="name">Documents</field>
        <field name="parent_id" ref="base.module_category_political_association" />
        <field name="sequence" eval="110" />
    </record>

    <record model="res.groups" id="group_document_reader">
        <field name="name">Reader</field>
        <field name="category_id" ref="module_category_document" />
        <field
            name="implied_ids"
            eval="[(6, 0, [
            ref('base.group_user'),
        ])]"
        />
    </record>

    <record model="res.groups" id="group_document_user">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_document" />
        <field
            name="implied_ids"
            eval="[(6, 0, [
            ref('group_document_reader'),
        ])]"
        />
    </record>

    <record model="res.groups" id="group_document_manager">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_document" />
        <field
            name="implied_ids"
            eval="[(6, 0, [
            ref('group_document_user'),
        ])]"
        />
        <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>


</odoo>
