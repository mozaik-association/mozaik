<odoo>

    <!-- Category -->
    <record id="module_category_territory" model="ir.module.category">
        <field name="name">Territories</field>
        <field name="sequence">20</field>
    </record>

    <!-- Groups -->
    <record id="group_territory_reader" model="res.groups">
        <field name="name">Reader</field>
        <field name="category_id" ref="module_category_territory" />
        <field name="comment">Can read territories</field>
    </record>

    <record id="group_territory_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_territory" />
        <field name="implied_ids" eval="[(4, ref('group_territory_reader'))]" />
        <field name="comment">Can use territories on contacts</field>
    </record>

    <record id="group_territory_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_territory" />
        <field name="implied_ids" eval="[(4, ref('group_territory_user'))]" />
        <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
        <field name="comment">Can create and manage territories</field>
    </record>

    <!-- Record Rules -->
    <record id="territory_read_rule" model="ir.rule">
        <field name="name">Territory: readers can read active territories</field>
        <field name="model_id" ref="model_territory" />
        <field name="groups" eval="[(4, ref('group_territory_reader'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
        <field name="domain_force">[('active', '=', True)]</field>
    </record>

    <record id="territory_manager_rule" model="ir.rule">
        <field name="name">Territory: managers can read all territories</field>
        <field name="model_id" ref="model_territory" />
        <field name="groups" eval="[(4, ref('group_territory_manager'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
