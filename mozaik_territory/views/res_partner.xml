<odoo>

    <record id="res_partner_view_form_territory" model="ir.ui.view">
        <field name="name">res.partner.form.territory</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="mozaik_thesaurus.res_partner_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='index']" position="inside">
                <separator string="Territories" />
                <field name="territory_ids" />
            </xpath>
        </field>
    </record>

</odoo>
